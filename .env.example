# backend.py仅将此文件加载到后端子进程，不会source/eval
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=travel_platform
# 独立测试库：必须是经确认的空测试库，不能与 DB_NAME 指向同一个库
DB_TEST_NAME=travel_platform_test
DB_USERNAME=travel_app
DB_PASSWORD=CHANGE_ME

# AI服务预设 openai / deepseek / qwen / custom
# 预设自动填充Base URL、模型和响应格式，下列非空字段可以覆盖。
AI_ENABLED=false
AI_PROVIDER=custom
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_CONNECT_TIMEOUT_SECONDS=5
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=6000
# auto按预设选择。兼容端点可显式设置json_object或json_schema。
AI_RESPONSE_FORMAT=auto

# 管理员由操作者核对自有注册账号后人工提升，见部署文档。
