+
+    await feed.loadFirst()
+    expect(feed.limitReached.value).toBe(true)
+    expect(feed.hasMore.value).toBe(false)
+    await feed.loadMore()
+    expect(fetchPage).toHaveBeenCalledTimes(1)
+  })
